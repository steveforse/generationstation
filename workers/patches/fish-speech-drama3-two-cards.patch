+    def layer_segments(self) -> list[tuple[torch.device, list[int]]]:
+        """Contiguous runs of layers on one device, in order: [(device, layer indices)]."""
+        segments: list[tuple[torch.device, list[int]]] = []
+        for index, layer in enumerate(self.model.layers):
+            device = layer.input_layernorm.weight.device
+            if segments and segments[-1][0] == device:
+                segments[-1][1].append(index)
+            else:
+                segments.append((device, [index]))
+        return segments
+
+    def run_segment(
+        self,
+        hidden: Tensor,
+        positions: Tensor,
+        indices: Sequence[int],
+        *,
+        kv_len: int,
+        final_norm: bool,
+    ) -> Tensor:
+        """One decode row through the layers `indices` (all on one device), as run_layers does for those
+        layers with cached state; the final norm when this is the last segment. Local patch: lets the
+        decoder capture one CUDA graph per device when the backbone spans several."""
+        device = self.model.layers[indices[0]].input_layernorm.weight.device
+        frequencies = self.inverse_frequencies.get(device)
+        if frequencies is None:
+            rotary_dim = self.config.rotary_dim
+            exponents = torch.arange(0, rotary_dim, 2, dtype=torch.float32, device=device)
+            frequencies = 1.0 / (self.config.rope_theta ** (exponents / rotary_dim))
+            self.inverse_frequencies[device] = frequencies
+        angles = positions.float()[:, None] * frequencies[None, :]
+        angles = torch.cat((angles, angles), dim=-1)
+        context = LayerContext(input_pos=positions, cos=angles.cos(), sin=angles.sin(), kv_len=kv_len,
+                               continue_state=True, use_cache=True)
+        for index in indices:
+            hidden = self.model.layers[index](hidden, context)
+        if final_norm:
+            return self.model.norm(hidden).to(self.dtype)
+        return hidden
+
     def compute_logits(self, hidden: Tensor) -> Tensor:
         return self.lm_head(hidden.to(self.lm_head.weight.device))
 
