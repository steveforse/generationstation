+class Drama3SplitDecodeGraphs(Drama3DecodeGraphs):
+    """Decode graphs for a backbone over two cards, the tower on the second (local patch).
+
+    One CUDA graph cannot span devices, so each step replays three: on the tower card, lm_head ->
+    tower (sample a frame) -> the codebook part of the next input; on the first card, the token
+    embedding and its layers; on the tower card, its layers and the final norm. Between them two tiny
+    tensors are copied. Without graphs the split decode runs eagerly and is launch-bound.
+    FISH_DRAMA3_SPLIT_GRAPH=0 disables.
+    """
+
+    @staticmethod
+    def supports(model: FishOmniModel) -> bool:
+        if os.environ.get("FISH_DRAMA3_SPLIT_GRAPH", "1") == "0":
+            return False
+        segments = model.backbone.layer_segments()
+        embed = model.backbone.model.embed_tokens.weight.device
+        tower = model.audio_decoder.device
+        return (len(segments) == 2 and segments[0][0] == embed and segments[1][0] == tower
+                and model.backbone.lm_head.weight.device == tower
+                and model.backbone.model.norm.weight.device == tower)
+
+    def __init__(self, model: FishOmniModel) -> None:
+        super().__init__(model)
+        backbone, tower = model.backbone, model.audio_decoder
+        (self.first_device, self.first_layers), (_, self.last_layers) = backbone.layer_segments()
+        hidden_size = model.config.text.hidden_size
+        count = tower.config.vq_backbone_codebooks
+        self.count = count
+        self.extra = torch.zeros((1, tower.config.dim), dtype=tower.codebook_embeddings.weight.dtype, device=tower.device)
+        self.semantic = torch.zeros(1, dtype=torch.bool, device=tower.device)
+        dev = self.first_device
+        self.main_first = torch.zeros(1, dtype=torch.long, device=dev)
+        self.extra_first = torch.zeros_like(self.extra, device=dev)
+        self.semantic_first = torch.zeros(1, dtype=torch.bool, device=dev)
+        self.position_first = torch.zeros(1, dtype=torch.long, device=dev)
+        self.middle_first = torch.zeros((1, 1, hidden_size), dtype=backbone.residual_dtype, device=dev)
+        self.middle = torch.zeros((1, 1, hidden_size), dtype=backbone.residual_dtype, device=tower.device)
+        self.pool_first = torch.cuda.graph_pool_handle()
+        # torch.cuda.graph's default capture stream is created once, on whichever device captures first;
+        # each card needs its own.
+        self.stream_tower = torch.cuda.Stream(device=tower.device)
+        self.stream_first = torch.cuda.Stream(device=dev)
+        self.split_graphs: dict[int, tuple[torch.cuda.CUDAGraph, ...]] = {}
+
+    def part_tower(self, kv_len: int) -> None:
+        backbone, tower = self.model.backbone, self.model.audio_decoder
+        logits = backbone.compute_logits(self.hidden)
+        self.finite.copy_(torch.isfinite(logits).all())
+        sampled = tower.decode_step(logits, self.hidden, self.position, self.frame, self.history,
+                                    temperature=self.temperature, top_k=self.top_k, top_p=self.top_p,
+                                    epsilon_cutoff=self.epsilon_cutoff, check_finite=False)
+        self.sampled.copy_(sampled)
+        self.extra.copy_(tower.embedding_sum(sampled, 1, 1 + self.count))
+        self.semantic.copy_(tower.is_semantic(sampled[:, 0]))
+
+    def part_first(self, kv_len: int) -> None:
+        backbone = self.model.backbone
+        text = backbone.model.embed_tokens(self.main_first)
+        mixed = (text + self.extra_first.to(text.dtype)) / math.sqrt(1 + self.count)
+        embeddings = torch.where(self.semantic_first[:, None], mixed, text)
+        hidden = embeddings[None].to(backbone.residual_dtype)
+        out = backbone.run_segment(hidden, self.position_first + 1, self.first_layers, kv_len=kv_len, final_norm=False)
+        self.middle_first.copy_(out)
+
+    def part_last(self, kv_len: int) -> None:
+        out = self.model.backbone.run_segment(self.middle, self.position + 1, self.last_layers, kv_len=kv_len,
+                                              final_norm=True)
+        self.next_hidden.copy_(out[0])
+
+    def hand_over(self) -> None:
+        self.main_first.copy_(self.sampled[:, 0])
+        self.extra_first.copy_(self.extra)
+        self.semantic_first.copy_(self.semantic)
+
+    def run(self, kv_len: int) -> None:  # eager, for warm-up
+        self.part_tower(kv_len)
+        self.hand_over()
+        with torch.cuda.device(self.first_device):
+            self.part_first(kv_len)
+        self.middle.copy_(self.middle_first)
+        self.part_last(kv_len)
+
+    def capture(self, kv_len: int) -> None:
+        for attention in self.tower_attentions():
+            attention.static_kv_len = kv_len
+        try:
+            for _ in range(2):
+                self.run(kv_len)
+            torch.cuda.synchronize(self.first_device)
+            torch.cuda.synchronize(self.model.audio_decoder.device)
+            tower_graph, first_graph, last_graph = (torch.cuda.CUDAGraph() for _ in range(3))
+            with torch.cuda.graph(tower_graph, pool=self.pool, stream=self.stream_tower):
+                self.part_tower(kv_len)
+            with torch.cuda.device(self.first_device):
+                with torch.cuda.graph(first_graph, pool=self.pool_first, stream=self.stream_first):
+                    self.part_first(kv_len)
+            with torch.cuda.graph(last_graph, pool=self.pool, stream=self.stream_tower):
+                self.part_last(kv_len)
+            self.split_graphs[kv_len] = (tower_graph, first_graph, last_graph)
+            self.graphs[kv_len] = tower_graph  # for the bucket bookkeeping of the base class
+        finally:
+            for attention in self.tower_attentions():
+                attention.static_kv_len = None
+
+    def start(self, hidden, position, prompt_frames, temperature, top_k, top_p, epsilon_cutoff=0.0) -> None:
+        super().start(hidden, position, prompt_frames, temperature, top_k, top_p, epsilon_cutoff)
+        self.position_first.fill_(position)
+
+    def step(self, position: int) -> tuple[torch.Tensor, int]:
+        kv_len = next(b for b in self.buckets if b >= position + 2)
+        tower_graph, first_graph, last_graph = self.split_graphs[kv_len]
+        if os.environ.get("FISH_DRAMA3_SPLIT_EAGER") == "1":  # debugging: the same steps without graphs
+            for attention in self.tower_attentions():
+                attention.static_kv_len = kv_len
+            try:
+                self.run(kv_len)
+            finally:
+                for attention in self.tower_attentions():
+                    attention.static_kv_len = None
+        else:
+            with torch.cuda.device(self.model.audio_decoder.device):
+                tower_graph.replay()
+            self.hand_over()
+            with torch.cuda.device(self.first_device):
+                first_graph.replay()
+            self.middle.copy_(self.middle_first)
+            with torch.cuda.device(self.model.audio_decoder.device):
+                last_graph.replay()
+        sampled = self.sampled.clone()
+        status = torch.stack((sampled[0, 0], self.finite.long()))
+        self.hidden.copy_(self.next_hidden)
+        self.frame.copy_(sampled)
+        self.history.copy_(torch.cat((self.history[1:], sampled[0, :1])))
+        self.position.add_(1)
+        self.position_first.add_(1)
+        main, finite = status.tolist()
+        if not finite:
+            raise FloatingPointError("non-finite logits; refusing to sample invalid audio")
+        return sampled, main
+
+
