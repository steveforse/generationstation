# Generate .env with python scripts/init_env.py. Never commit real secrets.
POSTGRES_PASSWORD=replace-with-random-password
GS_DB_PORT=5439
GS_DATABASE_URL=postgresql+psycopg://generationstation:replace-with-random-password@127.0.0.1:5439/generationstation
GS_API_TOKEN=replace-with-at-least-32-random-characters
GS_HOST_ROLE=development
GS_HOST_LABEL=Development machine
# M2 simulation admission cushions; provisional, not calibrated to the desktop.
GS_RAM_HEADROOM_BYTES=4294967296
GS_GPU_HEADROOM_BYTES=2147483648
# Native Windows deployment: change role to desktop and label to your host name.
# Only needed for a separately served frontend; production normally uses one origin.
GS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
